# CFI
CONFIG_CFI_CLANG=y

# Crypto
CONFIG_MMC_CRYPTO=y
CONFIG_CRYPTO_SM3=y
CONFIG_CRYPTO_SM3_ARM64_CE=y
CONFIG_CRYPTO_SM4=y
CONFIG_CRYPTO_SM4_ARM64_CE=y

# DTB
CONFIG_BUILD_ARM64_APPENDED_DTB_IMAGE=y

# exFAT
CONFIG_EXFAT_FS=y

# Filesystems
CONFIG_NTFS_FS=y
CONFIG_NTFS_RW=y
CONFIG_EXFAT_FS=y

# Fingerprint
CONFIG_INPUT_FINGERPRINT=y
CONFIG_FPC_FINGERPRINT=y
CONFIG_GOODIX_FINGERPRINT=y

# HZ
# CONFIG_HZ_100 is not set
CONFIG_HZ_300=y

# initramfs
CONFIG_INITRAMFS_IGNORE_SKIP_FLAG=y

# ION
CONFIG_ION_LEGACY=y

# KernelSU
CONFIG_KSU=y
CONFIG_KSU_MANUAL_HOOK=y

# Modules
# CONFIG_MODULE_SIG is not set
# CONFIG_MODULE_SIG_FORCE is not set
# CONFIG_MODULE_SIG_SHA512 is not set

# Pseudo filesystems
# CONFIG_SDCARD_FS is not set

# Pstore
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y

# WLAN
CONFIG_QCA_CLD_WLAN=y
